{
  "name": "opspilot-saas",
  "version": "1.0.0",
  "description": "OpsPilot - DevOps, SRE and CI/CD autopilot for businesses and startups (cloud, on-prem, hybrid)",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "OPSPILOT_DEMO=1 node src/index.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:adversarial": "node --test --test-concurrency=1 \"tests/adversarial/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "license": "MIT"
}
